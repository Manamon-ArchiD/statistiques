generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://imt:imt@localhost:5432/statistique_db"
}

model MatchStat {
  id        Int      @id @default(autoincrement())
  datetime  DateTime @default(now())
  matchId   Int
  playerId1 Int
  playerId2 Int
}

model StoreStat {
  id       Int      @id @default(autoincrement())
  datetime DateTime @default(now())
  itemId   Int
  price    Int
}

model UserStat {
  id       Int      @id @default(autoincrement())
  datetime DateTime @default(now())
  userId   Int
}
